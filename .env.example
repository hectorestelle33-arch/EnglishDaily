DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=90

# For this reading MVP, non-thinking mode is usually faster and stable enough.
# Use enabled only if you want slower, more expensive reasoning.
DEEPSEEK_THINKING=disabled

# Optional. The first MVP mainly uses RSS, but this is reserved for later
# Guardian Open Platform expansion.
GUARDIAN_API_KEY=
